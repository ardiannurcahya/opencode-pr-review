# Server
PORT=8080
CONFIG_PATH=./config.yaml

# GitHub App Secrets
WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./github-app.private-key.pem

# OpenCode Configuration (uses local authenticated session)
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=your_opencode_server_password_here
OPENCODE_DEFAULT_MODEL=anthropic/claude-sonnet-4-5
